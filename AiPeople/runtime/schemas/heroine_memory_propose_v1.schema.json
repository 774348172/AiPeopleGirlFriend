{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "proposals"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "MEMORY_PROPOSE"},
    "proposals": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "statement", "subject", "epistemic", "temporal", "evidence_quotes", "semantic_reason", "confidence", "relation_suggestions"],
        "properties": {
          "kind": {"enum": ["player_fact", "preference_boundary", "person_relation", "shared_experience", "relationship_meaning", "future_event", "unfinished_topic", "character_self_claim"]},
          "statement": {"type": "string", "minLength": 1, "maxLength": 300},
          "subject": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "entity_id", "display_name"],
            "properties": {
              "type": {"enum": ["player", "character", "both", "relationship", "third_party"]},
              "entity_id": {"type": ["string", "null"]},
              "display_name": {"type": ["string", "null"]}
            }
          },
          "epistemic": {
            "type": "object", "additionalProperties": false,
            "required": ["polarity", "modality", "grounding"],
            "properties": {
              "polarity": {"enum": ["affirmed", "negated"]},
              "modality": {"enum": ["asserted", "uncertain", "hypothetical", "joking", "quoted"]},
              "grounding": {"enum": ["speaker_report", "acknowledged", "mutually_confirmed", "runtime_observed"]}
            }
          },
          "temporal": {
            "type": "object", "additionalProperties": false,
            "required": ["relation", "resolution", "source_text", "anchor_event_id", "start_at", "end_at", "timezone", "precision"],
            "properties": {
              "relation": {"enum": ["past", "present", "future", "atemporal", "unknown"]},
              "resolution": {"enum": ["resolved", "relative", "ambiguous", "not_applicable"]},
              "source_text": {"type": ["string", "null"]},
              "anchor_event_id": {"type": ["string", "null"]},
              "start_at": {"type": ["string", "null"]},
              "end_at": {"type": ["string", "null"]},
              "timezone": {"type": ["string", "null"]},
              "precision": {"enum": ["instant", "minute", "hour", "part_of_day", "day", "range", "unknown", "not_applicable"]}
            }
          },
          "evidence_quotes": {
            "type": "array", "minItems": 1, "maxItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["event_id", "role", "quote", "start_hint"],
              "properties": {
                "event_id": {"type": "string", "minLength": 1},
                "role": {"enum": ["support", "contradict", "correction", "context"]},
                "quote": {"type": "string", "minLength": 1, "maxLength": 300},
                "start_hint": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          },
          "semantic_reason": {"type": "string", "minLength": 1, "maxLength": 160},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "relation_suggestions": {
            "type": "object", "additionalProperties": false,
            "required": ["semantic_slot", "supersedes", "contradicts", "refines"],
            "properties": {
              "semantic_slot": {"type": ["string", "null"]},
              "supersedes": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
              "contradicts": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
              "refines": {"type": "array", "maxItems": 4, "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
