{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["c"],
  "properties": {
    "c": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {"type": "integer", "minimum": 0, "maximum": 8},
              {"type": "string", "minLength": 1, "maxLength": 160},
              {"$ref": "#/$defs/evidenceAliases"}
            ]
          },
          {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {"enum": [9, 10]},
              {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_.-]+$"},
              {"type": "string", "minLength": 1, "maxLength": 160},
              {"$ref": "#/$defs/evidenceAliases"}
            ]
          }
        ]
      }
    },
    "a": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {"type": "string", "minLength": 1, "maxLength": 240},
          {"$ref": "#/$defs/evidenceAliases"}
        ]
      }
    }
  },
  "$defs": {
    "evidenceAliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
