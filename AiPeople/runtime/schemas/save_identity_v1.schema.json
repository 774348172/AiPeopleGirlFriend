{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipeople.local/schemas/save_identity_v1.schema.json",
  "title": "SaveIdentity V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "save_id",
    "world_id",
    "protagonist_id",
    "active_character_id",
    "installed_character_ids",
    "schema_version",
    "state_version"
  ],
  "properties": {
    "save_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "world_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "protagonist_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "active_character_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "installed_character_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    },
    "schema_version": {"const": 1},
    "state_version": {"type": "integer", "minimum": 1}
  }
}
