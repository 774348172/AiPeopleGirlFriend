{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["m"],
  "properties": {
    "m": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["k", "s", "e"],
        "properties": {
          "k": {"type": "integer", "minimum": 1, "maximum": 8},
          "s": {"type": "string", "minLength": 1, "maxLength": 300},
          "e": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "q": {"type": "integer", "minimum": 1, "maximum": 5},
          "t": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {"type": "integer", "minimum": 0, "maximum": 4},
              {"type": ["string", "null"], "minLength": 1, "maxLength": 120}
            ]
          },
          "r": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {"type": "integer", "minimum": 1, "maximum": 3},
              {"type": "integer", "minimum": 0}
            ]
          }
        }
      }
    }
  }
}
