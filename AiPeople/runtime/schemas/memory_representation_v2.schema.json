{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipeople.local/schemas/memory_representation_v2.schema.json",
  "title": "HeroineMemoryRepresentationV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "memory_id", "version", "save_id", "world_id",
    "owner_character_id", "conversation_id", "source_event_ids",
    "participant_ids", "observer_ids", "game_time", "kind", "statement",
    "subject", "epistemic", "temporal", "evidence", "semantic_reason",
    "confidence", "relations", "status", "created_at", "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "memory_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "save_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "owner_character_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": ["string", "null"], "minLength": 1},
    "source_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "participant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observer_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "game_time": {
      "type": "string",
      "pattern": "^[0-9]{4,}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?$"
    },
    "kind": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1, "maxLength": 500},
    "subject": {"type": "object"},
    "epistemic": {"type": "object"},
    "temporal": {"type": "object"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "semantic_reason": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "relations": {"type": "object"},
    "status": {"enum": ["active", "disputed", "superseded", "rejected"]},
    "created_at": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1}
  }
}
