{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "parent_mind_state_version", "snapshot_id", "transition_basis", "heroine_patch", "heroine_diegetic_actions", "reply_intent", "reply_state_assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "TURN_MIND_ADVANCE"},
    "parent_mind_state_version": {"type": "integer", "minimum": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "transition_basis": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "heroine_patch": {"$ref": "#/$defs/patch"},
    "heroine_diegetic_actions": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/action"}},
    "reply_intent": {"type": "string", "minLength": 1, "maxLength": 120},
    "reply_state_assertions": {"$ref": "#/$defs/assertions"}
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["living_mind_patch", "relationship_patch", "motive_updates", "knowledge_updates", "evidence_refs"],
      "properties": {
        "living_mind_patch": {"type": "object", "additionalProperties": false, "required": ["form", "body", "emotion", "attention", "current_activity", "immediate_intent"], "properties": {"form": {"$ref": "#/$defs/nullableText"}, "body": {"$ref": "#/$defs/nullableText"}, "emotion": {"$ref": "#/$defs/nullableText"}, "attention": {"$ref": "#/$defs/nullableText"}, "current_activity": {"$ref": "#/$defs/nullableText"}, "immediate_intent": {"$ref": "#/$defs/nullableText"}}},
        "relationship_patch": {"type": "object", "additionalProperties": false, "required": ["stage", "trust", "unresolved_tension"], "properties": {"stage": {"$ref": "#/$defs/nullableText"}, "trust": {"$ref": "#/$defs/nullableText"}, "unresolved_tension": {"$ref": "#/$defs/nullableText"}}},
        "motive_updates": {"type": "object", "maxProperties": 4, "additionalProperties": {"$ref": "#/$defs/nullableText"}},
        "knowledge_updates": {"type": "object", "maxProperties": 4, "additionalProperties": {"$ref": "#/$defs/nullableText"}},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "action": {"type": "object", "additionalProperties": false, "required": ["description", "evidence_refs"], "properties": {"description": {"type": "string", "minLength": 1, "maxLength": 300}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "assertions": {"type": "object", "additionalProperties": false, "required": ["protagonist_location_id", "protagonist_activity", "live_world_version", "captured_game_time"], "properties": {"protagonist_location_id": {"type": "string", "minLength": 1}, "protagonist_activity": {"type": "string", "minLength": 1}, "live_world_version": {"type": "integer", "minimum": 1}, "captured_game_time": {"type": "string", "minLength": 1}}}
  }
}
