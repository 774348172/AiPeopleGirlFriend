{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "snapshot_id", "reply", "mind_patch", "actions"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "JUDGE_TURN"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "reply": {"type": "string", "minLength": 1, "maxLength": 1000},
    "mind_patch": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/patch"}]
    },
    "actions": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["living_mind_patch", "relationship_patch", "motive_updates", "knowledge_updates", "evidence_refs"],
      "properties": {
        "living_mind_patch": {"type": "object", "additionalProperties": false, "required": ["form", "body", "emotion", "attention", "current_activity", "immediate_intent"], "properties": {"form": {"$ref": "#/$defs/nullableText"}, "body": {"$ref": "#/$defs/nullableText"}, "emotion": {"$ref": "#/$defs/nullableText"}, "attention": {"$ref": "#/$defs/nullableText"}, "current_activity": {"$ref": "#/$defs/nullableText"}, "immediate_intent": {"$ref": "#/$defs/nullableText"}}},
        "relationship_patch": {"type": "object", "additionalProperties": false, "required": ["stage", "trust", "unresolved_tension"], "properties": {"stage": {"$ref": "#/$defs/nullableText"}, "trust": {"$ref": "#/$defs/nullableText"}, "unresolved_tension": {"$ref": "#/$defs/nullableText"}}},
        "motive_updates": {"type": "object", "maxProperties": 4, "additionalProperties": {"$ref": "#/$defs/nullableText"}},
        "knowledge_updates": {"type": "object", "maxProperties": 4, "additionalProperties": {"$ref": "#/$defs/nullableText"}},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "action": {"type": "object", "additionalProperties": false, "required": ["action_id"], "properties": {"action_id": {"type": "string", "minLength": 1}, "params": {"type": ["object", "null"], "additionalProperties": true}}}
  }
}
