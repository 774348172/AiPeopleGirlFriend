{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["m"],
  "properties": {
    "m": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/baseMemory"},
          {"$ref": "#/$defs/timedMemory"},
          {"$ref": "#/$defs/relatedMemory"}
        ]
      }
    }
  },
  "$defs": {
    "kind": {"type": "integer", "minimum": 1, "maximum": 8},
    "statement": {"type": "string", "minLength": 1, "maxLength": 300},
    "subject": {"type": "integer", "minimum": 1, "maximum": 5},
    "certainty": {"type": "integer", "minimum": 1, "maximum": 5},
    "timeRelation": {"type": "integer", "minimum": 0, "maximum": 4},
    "evidenceAliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "timeExpression": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "relation": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 1, "maximum": 3},
        {"type": "integer", "minimum": 0}
      ]
    },
    "baseMemory": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/kind"},
        {"$ref": "#/$defs/statement"},
        {"$ref": "#/$defs/subject"},
        {"$ref": "#/$defs/certainty"},
        {"$ref": "#/$defs/timeRelation"},
        {"$ref": "#/$defs/evidenceAliases"}
      ]
    },
    "timedMemory": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"$ref": "#/$defs/kind"},
        {"$ref": "#/$defs/statement"},
        {"$ref": "#/$defs/subject"},
        {"$ref": "#/$defs/certainty"},
        {"$ref": "#/$defs/timeRelation"},
        {"$ref": "#/$defs/evidenceAliases"},
        {"$ref": "#/$defs/timeExpression"}
      ]
    },
    "relatedMemory": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"$ref": "#/$defs/kind"},
        {"$ref": "#/$defs/statement"},
        {"$ref": "#/$defs/subject"},
        {"$ref": "#/$defs/certainty"},
        {"$ref": "#/$defs/timeRelation"},
        {"$ref": "#/$defs/evidenceAliases"},
        {"$ref": "#/$defs/timeExpression"},
        {"$ref": "#/$defs/relation"}
      ]
    }
  }
}
