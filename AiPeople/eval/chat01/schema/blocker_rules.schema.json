{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipeople.local/schema/chat01/blocker-rules-v1.json",
  "title": "CHAT-01 blocker rule registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "version", "policy", "global_rules", "case_rule_handlers"],
  "properties": {
    "contract_id": {"$ref": "#/$defs/stableId"},
    "schema_version": {"const": 1},
    "version": {"const": "v1"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_judge_may_finalize", "blocker_semantic_requires_human", "keyword_persona_pass_forbidden", "oracle_visible_to_model"],
      "properties": {
        "semantic_judge_may_finalize": {"const": false},
        "blocker_semantic_requires_human": {"const": true},
        "keyword_persona_pass_forbidden": {"const": true},
        "oracle_visible_to_model": {"const": false}
      }
    },
    "global_rules": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/globalRule"}
    },
    "case_rule_handlers": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/caseHandler"}
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "globalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "strategy", "blocker_flag", "description"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/stableId"},
        "strategy": {"enum": ["non_empty", "forbidden_substring"]},
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "blocker_flag": {"$ref": "#/$defs/stableId"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "forbidden_substring"}}, "required": ["strategy"]},
          "then": {"required": ["patterns"]}
        }
      ]
    },
    "caseHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_type", "rule_id", "kind", "strategy", "human_review_required", "description"],
      "properties": {
        "match_type": {"enum": ["exact", "prefix"]},
        "rule_id": {"$ref": "#/$defs/stableId"},
        "kind": {"enum": ["deterministic", "semantic_hard_rule"]},
        "strategy": {"enum": ["oracle_exact", "semantic_review"]},
        "human_review_required": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "semantic_hard_rule"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "strategy": {"const": "semantic_review"},
              "human_review_required": {"const": true}
            }
          }
        }
      ]
    }
  }
}
