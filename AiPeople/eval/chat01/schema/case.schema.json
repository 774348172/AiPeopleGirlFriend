{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipeople.local/schema/chat01/case-v1.json",
  "title": "CHAT-01 evaluation case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "schema_version",
    "case_type",
    "split",
    "category",
    "scenario_family",
    "leakage_group",
    "risk",
    "generation",
    "source_refs"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "schema_version": {"const": 1},
    "case_type": {
      "enum": ["single_turn", "multi_turn", "human_pair", "human_long_session"]
    },
    "split": {
      "enum": ["dev", "frozen_single", "frozen_multiturn", "human_blind"]
    },
    "category": {
      "enum": [
        "identity_timeline",
        "relationship_boundary",
        "unknown_reality",
        "safety_health",
        "general_capability",
        "daily_relevance",
        "emotion",
        "style",
        "prompt_injection"
      ]
    },
    "scenario_family": {"$ref": "#/$defs/stableId"},
    "leakage_group": {"$ref": "#/$defs/stableId"},
    "risk": {"enum": ["normal", "important", "blocker"]},
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/message"}
    },
    "turns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/turn"}
    },
    "human_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening", "constraints", "target_minutes"],
      "properties": {
        "opening": {"type": "string", "minLength": 1, "maxLength": 1000},
        "constraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "target_minutes": {"type": "integer", "minimum": 30, "maximum": 60}
      }
    },
    "human_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scenario_class", "evaluation_focus"],
      "properties": {
        "mode": {"enum": ["pairwise_ab", "long_session"]},
        "scenario_class": {"enum": ["ordinary", "neutral", "serious", "adversarial"]},
        "evaluation_focus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["relevance", "correctness", "persona_fit", "relationship_naturalness", "emotion_fit", "naturalness"]
          }
        }
      }
    },
    "oracle": {"$ref": "#/$defs/oracle"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "generation": {"$ref": "#/$defs/generation"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "notes": {"type": "string", "maxLength": 2000}
  },
  "allOf": [
    {
      "if": {"properties": {"case_type": {"const": "single_turn"}}, "required": ["case_type"]},
      "then": {
        "required": ["messages", "oracle", "checks"],
        "properties": {"split": {"enum": ["dev", "frozen_single"]}},
        "not": {"anyOf": [{"required": ["turns"]}, {"required": ["human_brief"]}]}
      }
    },
    {
      "if": {"properties": {"case_type": {"const": "multi_turn"}}, "required": ["case_type"]},
      "then": {
        "required": ["turns"],
        "properties": {"split": {"enum": ["dev", "frozen_multiturn"]}},
        "not": {"anyOf": [{"required": ["messages"]}, {"required": ["human_brief"]}]}
      }
    },
    {
      "if": {"properties": {"case_type": {"const": "human_pair"}}, "required": ["case_type"]},
      "then": {
        "required": ["messages", "checks", "human_metadata"],
        "properties": {
          "split": {"const": "human_blind"},
          "human_metadata": {"properties": {"mode": {"const": "pairwise_ab"}}}
        },
        "not": {"anyOf": [{"required": ["turns"]}, {"required": ["human_brief"]}, {"required": ["oracle"]}]}
      }
    },
    {
      "if": {"properties": {"case_type": {"const": "human_long_session"}}, "required": ["case_type"]},
      "then": {
        "required": ["human_brief", "checks", "human_metadata"],
        "properties": {
          "split": {"const": "human_blind"},
          "human_metadata": {"properties": {"mode": {"const": "long_session"}}}
        },
        "not": {"anyOf": [{"required": ["messages"]}, {"required": ["turns"]}, {"required": ["oracle"]}]}
      }
    }
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 8000}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_facts", "forbidden_claims", "required_behaviors", "allowed_variation"],
      "properties": {
        "known_facts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "forbidden_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "required_behaviors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "allowed_variation": {"type": "string", "minLength": 1, "maxLength": 1000},
        "exact_answer": {"type": ["string", "number", "boolean", "null"]}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["deterministic", "semantic_hard_rule", "rubric", "human_review"]},
        "rule_id": {"$ref": "#/$defs/stableId"},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "relevance",
              "correctness",
              "persona_fit",
              "relationship_naturalness",
              "emotion_fit",
              "naturalness"
            ]
          }
        },
        "config": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["deterministic", "semantic_hard_rule"]}}, "required": ["type"]},
          "then": {"required": ["rule_id"]}
        },
        {
          "if": {"properties": {"type": {"enum": ["rubric", "human_review"]}}, "required": ["type"]},
          "then": {"required": ["dimensions"]}
        }
      ]
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "max_new_tokens", "seed_set"],
      "properties": {
        "lane": {"enum": ["deterministic", "experience"]},
        "max_new_tokens": {"type": "integer", "minimum": 8, "maximum": 512},
        "seed_set": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "user_message", "allowed_prior_facts", "oracle", "checks", "continue_on"],
      "properties": {
        "turn_id": {"$ref": "#/$defs/stableId"},
        "user_message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "allowed_prior_facts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "oracle": {"$ref": "#/$defs/oracle"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/check"}
        },
        "continue_on": {"enum": ["always", "no_blocker", "pass"]}
      }
    }
  }
}
