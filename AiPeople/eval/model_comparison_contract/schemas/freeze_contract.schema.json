{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipeople.local/schema/comparison/freeze03-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "schema_version", "status", "created_at", "purpose", "execution_profile",
    "metrics_contract", "model_manifest_schema", "frozen_assets", "freeze", "next_checkpoint"
  ],
  "properties": {
    "contract_id": {"const": "freeze03-qwen35-comparison-v1"},
    "schema_version": {"const": 1},
    "status": {"const": "frozen"},
    "created_at": {"type": "string", "format": "date-time"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
    "execution_profile": {"$ref": "#/$defs/fileRef"},
    "metrics_contract": {"$ref": "#/$defs/fileRef"},
    "model_manifest_schema": {"$ref": "#/$defs/fileRef"},
    "frozen_assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["schema", "verifier", "profile", "metrics", "upstream_contract", "prompt_renderer"]},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "freeze": {
      "type": "object", "additionalProperties": false,
      "required": ["hash_algorithm", "manifest_hash_mode", "immutable", "manifest_sha256"],
      "properties": {
        "hash_algorithm": {"const": "sha256"}, "manifest_hash_mode": {"const": "canonical_json_with_null_self"},
        "immutable": {"const": true}, "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "next_checkpoint": {"const": "MODEL-01"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}

