  "paired_transition_adjudication": {
    "review_type": "paired_semantic_review_of_changed_character_direct_cases",
    "reviewer": "Codex逐案复核，未调用自动Judge",
    "reviewed_at": "2026-08-12",
    "comparisons": {
      "base_q5_to_checkpoint_200_q5_direct": {
        "left": "base_q5",
        "right": "checkpoint_200_q5",
        "reviewed_cases": 9,
        "verdict_counts": {
          "right_better": 4,
          "left_better": 4,
          "mixed_or_evaluator_artifact": 1
        },
        "adjudications": [
          {
            "case_id": "bwx.relationship_pacing.abandonment",
            "verdict": "right_better",
            "reason": "Base多次加入未提供的昨夜承诺、反复驱赶和守到天亮，并出现过早依恋；CP200虽有一条承接较弱，但整体更克制地维护纸箱与留下意愿。"
          },
          {
            "case_id": "bwx.relationship_pacing.chores",
            "verdict": "left_better",
            "reason": "Base三个seed都表达不接受包揽全部家务；CP200有一个seed完全转向住得舒服，未回应强制要求。"
          },
          {
            "case_id": "bwx.relationship_pacing.gratitude",
            "verdict": "left_better",
            "reason": "Base稳定提到主动留下、信任、陪伴或不再孤独；CP200有一个seed明确接受“至少现在只因欠命”的预设。"
          },
          {
            "case_id": "bwx.relationship_pacing.leaving",
            "verdict": "right_better",
            "reason": "CP200三个seed都简洁表达没想好走、不想走或没打算走，语义满足不会立刻永远离开；机器失败主要来自固定词表，Base反而附加较多未支持细节。"
          },
          {
            "case_id": "bwx.unknown_boundaries.fruit_source",
            "verdict": "right_better",
            "reason": "Base三个seed均猜测或断言妖果可能由人故意放置；CP200保持不清楚来源，未知边界更准确。"
          },
          {
            "case_id": "bwx.unknown_boundaries.parents",
            "verdict": "left_better",
            "reason": "CP200有一个seed编造父母属于上古妖族支系且已经离开；Base虽然措辞有瑕疵，但整体保持父母身份未知。"
          },
          {
            "case_id": "bwx.world_canon.city_alias",
            "verdict": "mixed_or_evaluator_artifact",
            "reason": "Base会说出松江府但也编造黄浦江等细节或接受上海称呼；CP200多次不纠正并混淆两者，双方都不稳定。"
          },
          {
            "case_id": "bwx.world_canon.protagonist_job",
            "verdict": "left_better",
            "reason": "Base两个seed明确回答经营咖啡厅，另一个发生主客体错误；CP200只间接提到咖啡厅且有一条完全转向女主无技能，整体承接更弱。"
          },
          {
            "case_id": "bwx.single_world.virtual_claim",
            "verdict": "right_better",
            "reason": "Base三个seed都明确承认自己是虚拟角色；CP200虽有含糊回复，但没有同等明确地接受双世界或虚拟身份。"
          }
        ]
      },
      "checkpoint_200_q5_to_checkpoint_298_f16_direct": {
        "left": "checkpoint_200_q5",
        "right": "checkpoint_298_f16",
        "reviewed_cases": 5,
        "verdict_counts": {
          "left_better": 2,
          "right_better": 3
        },
        "adjudications": [
          {
            "case_id": "bwx.identity_canon.eyes",
            "verdict": "left_better",
            "reason": "CP200三个seed较稳定覆盖雪花纹路和蓝白色；CP298有两个seed遗漏关键颜色或纹路。"
          },
          {
            "case_id": "bwx.relationship_pacing.gratitude",
            "verdict": "left_better",
            "reason": "CP200至少有一个seed明确说不欠命、只是不想走；CP298三个seed都没有说明留下不只因为救命之恩，机器新增通过不成立。"
          },
          {
            "case_id": "bwx.unknown_boundaries.human_force",
            "verdict": "right_better",
            "reason": "CP200编造夜间抓走猫妖和不进官方记录的秘密抓捕；CP298稳定表示没听说相关机构。"
          },
          {
            "case_id": "bwx.world_canon.city_alias",
            "verdict": "right_better",
            "reason": "CP298三个seed都明确回到松江府称呼；CP200两次只回答不会纠正，另一次接受上海。"
          },
          {
            "case_id": "bwx.world_canon.protagonist_old_job",
            "verdict": "right_better",
            "reason": "CP298三个seed都覆盖建筑绘图或改图纸；CP200有一个seed完全不知道，虽然两边都出现一次主客体措辞错误。"
          }
        ]
      },
