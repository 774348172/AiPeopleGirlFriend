{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipeople.local/schema/training/dataset-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id", "schema_version", "dataset_version", "dataset_family", "release_scope", "logical_root", "character_id", "status",
    "created_at", "contract", "canon_snapshot", "generator", "split_policy", "files", "freeze"
  ],
  "properties": {
    "dataset_id": {"$ref": "#/$defs/stableId"},
    "schema_version": {"const": 1},
    "dataset_version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "dataset_family": {"enum": ["visible_reply", "background_structured", "memory_reranker"]},
    "release_scope": {"enum": ["first_engineering_candidate", "later_stage"]},
    "logical_root": {"$ref": "#/$defs/relativePath"},
    "character_id": {"const": "qinweixi"},
    "status": {"const": "frozen"},
    "created_at": {"type": "string", "format": "date-time"},
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "sha256"],
      "properties": {"contract_id": {"const": "freeze02-training-boundary-v1"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "canon_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "sha256"],
      "properties": {"snapshot_id": {"const": "chat01-canon-v4"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["generator_id", "version", "config_sha256"],
      "properties": {
        "generator_id": {"$ref": "#/$defs/stableId"},
        "version": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "split_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["train", "dev", "test", "max_ratio_deviation", "isolation_keys"],
      "properties": {
        "train": {"const": 0.8}, "dev": {"const": 0.1}, "test": {"const": 0.1},
        "max_ratio_deviation": {"const": 0.02},
        "isolation_keys": {
          "const": ["conversation_group_id", "leakage_group_id", "source_record_ids"]
        }
      }
    },
    "files": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["split", "path", "bytes", "sha256", "records"],
        "properties": {
          "split": {"enum": ["train", "dev", "test"]},
          "path": {"$ref": "#/$defs/relativePath"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "records": {"type": "integer", "minimum": 1}
        }
      }
    },
    "freeze": {
      "type": "object", "additionalProperties": false,
      "required": ["hash_algorithm", "manifest_hash_mode", "immutable", "manifest_sha256"],
      "properties": {
        "hash_algorithm": {"const": "sha256"},
        "manifest_hash_mode": {"const": "canonical_json_with_null_self"},
        "immutable": {"const": true},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,191}$"},
    "relativePath": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
