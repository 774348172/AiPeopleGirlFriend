{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipeople.local/schema/chat02/model-manifest-v1.json",
  "title": "CHAT-02B model manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "schema_version", "created_at", "role", "status", "asset", "identity", "source", "adaptation", "export_provenance", "runtime_contract", "comparability", "excluded_inputs", "notes"],
  "properties": {
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "role": {"enum": ["base", "trained"]},
    "status": {"const": "verified"},
    "asset": {"$ref": "#/$defs/artifact"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "parameter_class", "quantization", "gguf_file_type", "tensor_count", "native_context_length", "eos_token_id", "chat_template_bytes", "chat_template_sha256"],
      "properties": {
        "architecture": {"const": "qwen3"},
        "parameter_class": {"const": "4B"},
        "quantization": {"const": "Q4_K_M"},
        "gguf_file_type": {"const": 15},
        "tensor_count": {"type": "integer", "minimum": 1},
        "native_context_length": {"type": "integer", "minimum": 4096},
        "eos_token_id": {"type": "integer", "minimum": 0},
        "chat_template_bytes": {"type": "integer", "minimum": 1},
        "chat_template_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "local_source_revision", "training_source_revision", "revision_note"],
      "properties": {
        "repository": {"const": "Qwen/Qwen3-4B"},
        "local_source_revision": {"anyOf": [{"$ref": "#/$defs/revision"}, {"type": "null"}]},
        "training_source_revision": {"anyOf": [{"$ref": "#/$defs/revision"}, {"type": "null"}]},
        "revision_note": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter_checkpoint", "merge_method", "evidence", "note"],
      "properties": {
        "kind": {"enum": ["none", "lora"]},
        "adapter_checkpoint": {"type": ["string", "null"], "maxLength": 500},
        "merge_method": {"type": ["string", "null"], "maxLength": 200},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
        "note": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "export_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["converter", "converter_module", "gguf_python_version", "quantizer", "note"],
      "properties": {
        "converter": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "converter_module": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "gguf_python_version": {"type": ["string", "null"], "maxLength": 100},
        "quantizer": {"anyOf": [{"$ref": "#/$defs/toolArtifact"}, {"type": "null"}]},
        "note": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_template", "thinking", "context_size", "stop_contract", "execution_profile_id"],
      "properties": {
        "chat_template": {"const": "embedded_qwen3"},
        "thinking": {"const": false},
        "context_size": {"const": 4096},
        "stop_contract": {"const": "embedded_eos_151645_no_explicit_stop"},
        "execution_profile_id": {"const": "chat02-shared-llamacpp-b10256-v1"}
      }
    },
    "runtime_manifest_reference": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "compared_to", "controlled_traits", "limitations"],
      "properties": {
        "status": {"const": "comparable_with_limitations"},
        "compared_to": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "controlled_traits": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
      }
    },
    "excluded_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "reason"],
        "properties": {"artifact": {"$ref": "#/$defs/artifact"}, "reason": {"type": "string", "minLength": 1, "maxLength": 1000}}
      }
    },
    "notes": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "absolutePath": {"type": "string", "minLength": 3, "maxLength": 1000, "pattern": "^[A-Za-z]:\\\\"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "toolArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "release"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "release": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    }
  }
}
