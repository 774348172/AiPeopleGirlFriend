{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipeople.local/schemas/mode_v4/memory_rerank_target.schema.json",
  "title": "MemoryRerankTargetV4",
  "description": "MEMORY_RERANK mode 的目标（2026-08-09）：query（最近对话/当前消息/工作状态）+ 每个候选记忆的激活标签。",
  "type": "object",
  "required": ["query", "labels"],
  "properties": {
    "query": {
      "type": "object",
      "required": ["recent_dialogue", "current_user_message", "working_state"],
      "properties": {
        "recent_dialogue": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 4
        },
        "current_user_message": { "type": "string" },
        "working_state": { "type": "string" }
      },
      "additionalProperties": true
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["memory_id", "label", "relevance_score", "should_recall", "label_evidence"],
        "properties": {
          "memory_id": { "type": "string" },
          "label": {
            "type": "string",
            "enum": ["positive", "hard_negative", "easy_negative"]
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "should_recall": { "type": "boolean" },
          "label_evidence": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
