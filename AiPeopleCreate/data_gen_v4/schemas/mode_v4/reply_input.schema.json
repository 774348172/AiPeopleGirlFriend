{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipeople.local/schemas/mode_v4/reply_input.schema.json",
  "title": "ReplyInputV4",
  "description": "REPLY mode 的模型输入（《数据生成器v4设计》§10.1）。阶段 2 冻结（方案 A，不依赖运行时）。",
  "type": "object",
  "required": ["scene", "player_view", "topic"],
  "properties": {
    "scene": { "type": "string" },
    "player_view": { "type": "string", "description": "玩家可见信息；不含角色秘密或 oracle state（§10.1）" },
    "topic": { "type": "string" },
    "turn_bounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 2 }
    }
  },
  "additionalProperties": true
}
