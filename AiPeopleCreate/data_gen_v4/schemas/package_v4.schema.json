{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipeople.local/schemas/package_v4.schema.json",
  "title": "PackageV4",
  "description": "V4 四类 package（profile/protocol/recipe/release）的判别联合合同。阶段 0 冻结（2026-08-04），对应《数据生成器v4设计》§5。",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/ProfilePackage" },
    { "$ref": "#/definitions/ProtocolBundle" },
    { "$ref": "#/definitions/DatasetRecipe" },
    { "$ref": "#/definitions/ReleasePolicy" }
  ],
  "definitions": {
    "PackageHeader": {
      "type": "object",
      "required": [
        "package_id",
        "package_type",
        "schema_version",
        "package_version",
        "content_hash",
        "compatible_core_range",
        "dependencies",
        "created_at",
        "status"
      ],
      "properties": {
        "package_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "package_type": { "type": "string", "enum": ["profile", "protocol", "recipe", "release"] },
        "schema_version": { "type": "string", "pattern": "^aip\\.(profile|protocol|recipe|release)\\.v4$" },
        "package_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "compatible_core_range": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^pkg:[a-z0-9][a-z0-9._-]*@[0-9]+\\.[0-9]+\\.[0-9]+$" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["draft", "approved", "deprecated"] }
      },
      "additionalProperties": true
    },
    "ProfilePackage": {
      "allOf": [
        { "$ref": "#/definitions/PackageHeader" },
        {
          "type": "object",
          "required": [
            "package_type",
            "profile_id",
            "locale",
            "identity_sources",
            "canon_sources",
            "visibility_model",
            "style_contract",
            "disclosure_policy",
            "capability_traits",
            "source_validators",
            "style_validators",
            "profile_prompt_fragments",
            "profile_evaluation_suites"
          ],
          "properties": {
            "package_type": { "const": "profile" },
            "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
            "identity_sources": { "type": "array", "items": { "type": "string" } },
            "canon_sources": { "type": "array", "items": { "type": "string" } },
            "timeline_sources": { "type": "array", "items": { "type": "string" } },
            "memory_sources": { "type": "array", "items": { "type": "string" } },
            "relationship_model": { "type": ["string", "null"] },
            "visibility_model": { "type": "string" },
            "style_contract": { "type": "string" },
            "disclosure_policy": {
              "type": "string",
              "enum": ["direct_allowed", "hint_only", "withhold"]
            },
            "label_schema": { "type": ["string", "null"] },
            "capability_traits": { "type": "array", "items": { "type": "string" } },
            "source_validators": { "type": "array", "items": { "type": "string" } },
            "style_validators": { "type": "array", "items": { "type": "string" } },
            "profile_prompt_fragments": { "type": "array", "items": { "type": "string" } },
            "profile_evaluation_suites": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      ]
    },
    "ProtocolBundle": {
      "allOf": [
        { "$ref": "#/definitions/PackageHeader" },
        {
          "type": "object",
          "required": ["package_type", "protocol_bundle_id", "modes"],
          "properties": {
            "package_type": { "const": "protocol" },
            "protocol_bundle_id": { "type": "string" },
            "modes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "mode_id",
                  "mode_adapter_id",
                  "input_schema_ref",
                  "target_schema_ref",
                  "render_profile_id",
                  "scheduling_semantics",
                  "failure_policy"
                ],
                "properties": {
                  "mode_id": { "type": "string" },
                  "mode_adapter_id": { "type": "string" },
                  "input_schema_ref": { "type": "string" },
                  "target_schema_ref": { "type": "string" },
                  "grammar_ref": { "type": ["string", "null"] },
                  "render_profile_id": { "type": "string" },
                  "scheduling_semantics": { "type": "string" },
                  "failure_policy": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "DatasetRecipe": {
      "allOf": [
        { "$ref": "#/definitions/PackageHeader" },
        {
          "type": "object",
          "required": [
            "package_type",
            "recipe_id",
            "strata",
            "memory_selection_policy",
            "refusal_bounds",
            "training_mix"
          ],
          "properties": {
            "package_type": { "const": "recipe" },
            "recipe_id": { "type": "string" },
            "strata": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "task_type",
                  "mode_id",
                  "target_count",
                  "min_family_count",
                  "candidate_count",
                  "risk_level",
                  "review_requirement"
                ],
                "properties": {
                  "task_type": { "type": "string" },
                  "mode_id": { "type": "string" },
                  "target_count": { "type": "integer", "minimum": 0 },
                  "min_family_count": { "type": "integer", "minimum": 0 },
                  "evidence_state_distribution": { "type": "object" },
                  "policy_distribution": { "type": "object" },
                  "candidate_count": { "type": "integer", "minimum": 1 },
                  "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
                  "review_requirement": {
                    "type": "string",
                    "enum": ["full", "family_sample", "cluster_sample", "auto"]
                  }
                },
                "additionalProperties": true
              }
            },
            "contrast_suites": { "type": "array", "items": { "type": "string" } },
            "memory_selection_policy": { "type": "object" },
            "refusal_bounds": { "type": "object" },
            "training_mix": { "type": "object" }
          },
          "additionalProperties": true
        }
      ]
    },
    "ReleasePolicy": {
      "allOf": [
        { "$ref": "#/definitions/PackageHeader" },
        {
          "type": "object",
          "required": [
            "package_type",
            "release_policy_id",
            "required_core_gates",
            "required_profile_validators",
            "required_protocol_validators",
            "human_review_rules",
            "metric_thresholds",
            "sealed_evaluation_refs",
            "allowed_export_profiles",
            "curation_policy",
            "split_policy"
          ],
          "properties": {
            "package_type": { "const": "release" },
            "release_policy_id": { "type": "string" },
            "required_core_gates": {
              "type": "array",
              "items": { "type": "string", "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"] },
              "allOf": [
                { "contains": { "const": "G0" } },
                { "contains": { "const": "G1" } },
                { "contains": { "const": "G2" } },
                { "contains": { "const": "G3" } }
              ]
            },
            "required_profile_validators": { "type": "array", "items": { "type": "string" } },
            "required_protocol_validators": { "type": "array", "items": { "type": "string" } },
            "human_review_rules": { "type": "array", "items": { "type": "string" } },
            "metric_thresholds": { "type": "object" },
            "sealed_evaluation_refs": { "type": "array", "items": { "type": "string" } },
            "allowed_export_profiles": { "type": "array", "items": { "type": "string" } },
            "curation_policy": {
              "type": "object",
              "required": [
                "exact_normalization",
                "ngram_range",
                "minhash_params",
                "embedding_model_ref",
                "allowed_dedup_modes"
              ],
              "properties": {
                "exact_normalization": { "type": "string" },
                "ngram_range": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "integer", "minimum": 1 }
                },
                "minhash_params": { "type": "object" },
                "embedding_model_ref": { "type": ["string", "null"] },
                "allowed_dedup_modes": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["exact", "minhash", "embedding"] }
                }
              },
              "additionalProperties": true
            },
            "split_policy": {
              "type": "object",
              "required": ["initial_ratios", "max_component_ratio"],
              "properties": {
                "initial_ratios": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "max_component_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
