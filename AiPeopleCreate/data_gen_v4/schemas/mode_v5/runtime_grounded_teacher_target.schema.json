{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipeople.local/schemas/mode_v5/runtime_grounded_teacher_target.schema.json",
  "title": "RuntimeGroundedReplyTeacherTargetV1",
  "description": "离线教师只生成当前角色回复和审计辅助 claims，不得生成场景或历史。",
  "type": "object",
  "required": ["reply", "declared_claims"],
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "declared_claims": {
      "type": "array",
      "items": {"$ref": "#/definitions/Claim"}
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Claim": {
      "type": "object",
      "required": ["subject", "predicate", "object", "polarity", "temporal_status", "source_fact_ids"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "object": {"type": "string"},
        "polarity": {"type": "string", "enum": ["positive", "negative"]},
        "temporal_status": {"type": "string", "enum": ["current", "past", "future", "unknown"]},
        "source_fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
